{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "family-screen-example",
  "main": "./server/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/thumbnails/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "family-screen-example-db", "migrations_dir": "./migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "family-screen-example-media" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.01 }
}
